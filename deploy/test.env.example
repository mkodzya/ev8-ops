# EV8 Ops — the test stand on the server (runs develop).
#
# Copy to deploy/prod.env ON THE SERVER and fill it there. This file is the
# shape, not the values: deploy/*.env is in .gitignore and no secret of the
# real stand is ever committed, pasted into a chat or written into a document.
#
# Generate the three machine secrets with:
#   openssl rand -base64 48
# They are never typed by a person, so they are long and random and nobody
# needs to remember them.

STAND_NAME=ops-test
STAND_HOST=test.ops.ev8.ge

# --- machine secrets: generate, do not invent -----------------------------
POSTGRES_PASSWORD=
SESSION_SECRET=
WORKER_TOKEN=

# --- the first owner login ------------------------------------------------
# Mika sets this himself and stores it in his password manager. It is used
# once, on an empty database, to create the first owner; after the first
# sign-in it can be changed in "Мой вход" and this line emptied.
OWNER_EMAIL=
OWNER_PASSWORD=

# The hostname vite answers to; the same as STAND_HOST.
ALLOWED_HOSTS=test.ops.ev8.ge

TZ=Asia/Tbilisi
DEFAULT_LOCALE=ka
