# EV8 Ops — QA stand on this Mac, next to the laptop stack.
# Read by scripts/qa-stand.sh. Only ports differ from the laptop defaults;
# nothing here is a secret (the laptop stack's dev secret is accepted because
# ALLOW_DEV_SECRET stays true, exactly as on the laptop stack).
DB_PORT=5443
# Loopback only: the copy holds customers' personal data, and the compose file
# takes "host:port" here as it is. The laptop stack's own web and API still
# listen on every interface; this stand does not.
API_PORT=127.0.0.1:8092
WEB_PORT=127.0.0.1:5185
