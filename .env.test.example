# EV8 Ops — the test stack on the server (its own database, its own secrets).
#
# Copy to .env.prod ON THE SERVER and fill it in there. This file is the
# shape, not the values: .env.* is in .gitignore, and no secret of the real
# stack is ever committed, pasted into a chat or written into a document.
#
#   cp .env.prod.example .env.test
#   docker compose -p ev8-test --env-file .env.test -f docker-compose.prod.yml up -d --build
#
# Every value below is REQUIRED unless it says otherwise: compose refuses to
# start when one is missing and names it. A stack that cannot come up beats
# one that comes up wrong and says nothing.

# --- the database ----------------------------------------------------------
POSTGRES_USER=ev8ops
POSTGRES_DB=ev8ops
# openssl rand -base64 36 | tr -d '/+='
POSTGRES_PASSWORD=

# --- machine secrets: generate, never invent -------------------------------
# openssl rand -base64 48
SESSION_SECRET=
WORKER_TOKEN=

# --- the first owner login -------------------------------------------------
# Used once, while the database is empty. Choose the password yourself and
# keep it in your password manager; after the first sign-in change it in
# "Мой вход" and empty this line.
OWNER_EMAIL=mika@selfstudio.se
OWNER_NAME=Mika
OWNER_PASSWORD=

# --- this stack's loopback port --------------------------------------------
# prod 5173, test 5174. The edge proxy reaches the stack here; nothing else can.
WEB_PORT=5174

TZ=Asia/Tbilisi
DEFAULT_LOCALE=ka
