// EV8 Ops — Prisma schema. Migrations are hand-written SQL in
// apps/api/migrations/, applied by scripts/migrate.mjs (hermetic, no Prisma
// engines). This file exists to generate the type-safe client only; keep it
// in sync with the SQL by hand.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
  mechanic
  chief_mechanic

  @@map("user_role")
}

enum VehicleState {
  available
  rented
  service
  out
  sold

  @@map("vehicle_state")
}

enum VehicleEventKind {
  arrived
  pickup
  return
  service_in
  service_out
  sold
  bought_back
  written_off
  manual
  to_rent
  to_sale

  @@map("vehicle_event_kind")
}

/// What a moped is here for. Nullable on a vehicle: nobody has decided yet.
enum VehiclePool {
  rent
  sale

  @@map("vehicle_pool")
}

enum RentalStatus {
  booked
  active
  overdue
  paused
  returned
  disputed

  @@map("rental_status")
}

enum PeriodPayStatus {
  unpaid
  partial
  paid

  @@map("period_pay_status")
}

enum DepositStatus {
  held
  returned
  withheld
  partial

  @@map("deposit_status")
}

/// What an owner said about a deposit Odoo brought over (wave 6 §3.7). The
/// money moved before the transfer, or nobody wrote down that it did; either
/// way it is not a payout made today.
enum DepositMigrationDecision {
  returned_earlier
  kept_earlier
  unknown

  @@map("deposit_migration_decision")
}

enum ActKind {
  pickup
  return
  /// A swap in a running rental (migration 0063, ADR-0040): the moped given back, and the one handed out in its place.
  swap_out
  swap_in

  @@map("act_kind")
}

enum CustomerKind {
  person
  sole_trader
  company

  @@map("customer_kind")
}

enum PaymentChannel {
  transfer
  acquiring
  cash
  deposit

  @@map("payment_channel")
}

enum PaymentDirection {
  in
  out

  @@map("payment_direction")
}

enum PaymentSource {
  manual
  statement
  log
  deposit

  @@map("payment_source")
}

enum PaymentKind {
  rent
  sale
  service
  on_account
  deposit_payout
  buyback
  supplier

  @@map("payment_kind")
}

enum HandoverStatus {
  pending
  accepted
  disputed

  @@map("handover_status")
}

enum AllocationTarget {
  period
  deposit
  instalment
  charge

  @@map("allocation_target")
}

enum PurchaseStatus {
  ordered
  received
  cancelled

  @@map("purchase_status")
}

enum SaleStatus {
  active
  cancelled
  bought_back

  @@map("sale_status")
}

enum BankName {
  bog
  tbc
  credo

  @@map("bank_name")
}

enum StatementLineStatus {
  unmatched
  matched
  ignored

  @@map("statement_line_status")
}

enum FileKind {
  act_photo
  customer_document
  service_photo
  pdf

  @@map("file_kind")
}

/// What a repair line is (0058): off the shelf, bought by the mechanic, taken
/// off this moped onto the shelf, or taken off a donor and fitted here.
enum ServicePartKind {
  stock
  bought
  removed
  donor

  @@map("service_part_kind")
}

enum ServiceStatus {
  /// A breakdown a manager reported: an owner turns it into a repair (wave 5 §3.7).
  draft
  open
  done
  cancelled

  @@map("service_status")
}

enum ServicePayer {
  company
  customer

  @@map("service_payer")
}

/// Why a repair came in — the bot's five reasons (stage 2 of the mechanic plan, 0056).
enum ServiceReason {
  wear
  accident
  renter_fault
  warranty
  planned

  @@map("service_reason")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Empty only for a mechanic who signs in with a PIN on the workshop tablet (0055).
  email           String?   @unique
  name            String
  passwordHash    String?   @map("password_hash")
  role            UserRole
  locale          String    @default("ka")
  active          Boolean   @default(true)
  /// The workshop PIN, hashed like a password; never returned (ADR-0033).
  pinHash         String?   @map("pin_hash")
  pinFailed       Int       @default(0) @map("pin_failed")
  pinLockedUntil  DateTime? @map("pin_locked_until")
  /// A mechanic's rate for an hour of norm; empty is the company's rate.
  labourRateTetri Int?      @map("labour_rate_tetri")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  sessions          Session[]
  operationKeys     OperationKey[]
  rentalsCreated    Rental[]       @relation("rental_created_by")
  contractsMarkedSigned Rental[]   @relation("rental_contract_signed_elsewhere_by")
  depositsDecided   Deposit[]      @relation("deposit_decided_by")
  depositsConfirmed Deposit[]      @relation("deposit_confirmed_by")
  actsCreated       Act[]
  vehicleEvents     VehicleEvent[]
  auditEntries      AuditLog[]
  filesUploaded     StoredFile[]
  paymentsCreated   Payment[]     @relation("payment_created_by")
  batteryCounts     BatteryInventory[]
  batteryMoves      BatteryMove[]
  paymentsVoided    Payment[]     @relation("payment_voided_by")
  statements        Statement[]
  serviceJobs       ServiceJob[]   @relation("service_job_created_by")
  repairsCarried    ServiceJob[]   @relation("service_job_mechanic")
  worksDone         ServiceWork[]  @relation("service_work_mechanic")
  worksWritten      ServiceWork[]  @relation("service_work_created_by")
  repairsApproved   ServiceJob[]   @relation("service_job_approved_by")
  repairsRejected   ServiceJob[]   @relation("service_job_rejected_by")
  worksApproved     ServiceWork[]  @relation("service_work_approved_by")
  worksRejected     ServiceWork[]  @relation("service_work_rejected_by")
  partsWritten      ServicePart[]  @relation("service_part_created_by")
  partsReimbursed   ServicePart[]  @relation("service_part_reimburse_to")
  partsApproved     ServicePart[]  @relation("service_part_approved_by")
  partsRejected     ServicePart[]  @relation("service_part_rejected_by")
  trackersFitted    VehicleTracker[] @relation("vehicle_tracker_created_by")
  trackersRemoved   VehicleTracker[] @relation("vehicle_tracker_removed_by")
  workTypesAdded    WorkType[]
  sales             Sale[]
  purchases         Purchase[]
  parts             Part[]
  stockMoves        StockMove[]
  locations         Location[]    @relation("location_author")
  rentalSettings    RentalSettings[]
  serviceSettings   ServiceSettings[]
  quickRates        QuickRate[]
  workshops         Workshop[]
  handoversFrom     CashHandover[] @relation("handover_from")
  handoversDecided  CashHandover[] @relation("handover_decided_by")
  bankDeposits      BankCashDeposit[]
  devicesRegistered WorkshopDevice[] @relation("device_registered_by")
  devicesRevoked    WorkshopDevice[] @relation("device_revoked_by")
  payoutsReceived   MechanicPayout[] @relation("mechanic_payout_mechanic")
  payoutsMarked     MechanicPayout[] @relation("mechanic_payout_marked_by")
  payoutsVoided     MechanicPayout[] @relation("mechanic_payout_voided_by")

  @@map("users")
}

/// A form's key for one write (migration 0016): the first answer is kept and
/// replayed to any repeat, so a retry never writes twice.
model OperationKey {
  userId     String   @map("user_id") @db.Uuid
  key        String
  route      String
  statusCode Int?     @map("status_code")
  body       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("operation_keys")
}

/// A failed sign-in, counted in rows so a restart of the API does not forgive
/// the attempts (wave 6 §3.9, crit. 22). No password, ever.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt(sort: Desc)], map: "login_attempts_email_idx")
  @@map("login_attempts")
}

model Session {
  token      String      @id
  userId     String      @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  lastSeenAt DateTime    @default(now()) @map("last_seen_at")
  expiresAt  DateTime    @map("expires_at")
  /// How the sign-in began: a PIN session belongs to a workshop device (0055).
  kind       SessionKind @default(password)
  deviceId   String?     @map("device_id") @db.Uuid

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  device WorkshopDevice? @relation(fields: [deviceId], references: [id])

  @@map("sessions")
}

enum SessionKind {
  password
  pin

  @@map("session_kind")
}

/// The workshop's shared tablet (ADR-0033 §5). Its token is the id and a
/// secret; only the secret's scrypt hash is kept. Revoked, never deleted.
model WorkshopDevice {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  secretHash   String    @map("secret_hash")
  registeredBy String    @map("registered_by") @db.Uuid
  registeredAt DateTime  @default(now()) @map("registered_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    String?   @map("revoked_by") @db.Uuid

  registrar User      @relation("device_registered_by", fields: [registeredBy], references: [id])
  revoker   User?     @relation("device_revoked_by", fields: [revokedBy], references: [id])
  sessions  Session[]

  @@map("workshop_devices")
}

model VehicleModel {
  id                  String   @id @default(uuid()) @db.Uuid
  brand               String
  name                String
  salePriceTetri      Int?     @map("sale_price_tetri")
  weeklyRateTetri     Int?     @map("weekly_rate_tetri")
  costTetri           Int?     @map("cost_tetri")
  forSale             Boolean  @default(true) @map("for_sale")
  forRent             Boolean  @default(false) @map("for_rent")
  photoUrl            String?  @map("photo_url")
  notes               String?
  odooSaleProductId   Int?     @unique @map("odoo_sale_product_id")
  odooRentalProductId Int?     @unique @map("odoo_rental_product_id")
  odooFleetModelId    Int?     @unique @map("odoo_fleet_model_id")
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  vehicles      Vehicle[]
  purchaseLines PurchaseLine[]

  @@unique([brand, name])
  @@map("vehicle_models")
}

/// Where a moped physically stands. The list is the company's own words for
/// its places; a moped out on rent carries none, because it is at a customer.
model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// showroom · store · workshop · swap — a kind so the swap network needs no
  /// rebuild when it arrives (B10-02). Nothing behaves differently by it yet.
  kind      String   @default("showroom")
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  createdById String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  createdBy User?     @relation("location_author", fields: [createdById], references: [id])
  vehicles  Vehicle[]
  closedJobs ServiceJob[]

  @@map("locations")
}

model Vehicle {
  id              String       @id @default(uuid()) @db.Uuid
  vin             String       @unique
  modelId         String       @map("model_id") @db.Uuid
  color           String?
  year            Int?
  arrivedOn       DateTime?    @map("arrived_on") @db.Date
  state           VehicleState @default(available)
  pool            VehiclePool?
  currentRentalId String?      @map("current_rental_id") @db.Uuid
  locationId      String?      @map("location_id") @db.Uuid
  odometerKm      Int?         @map("odometer_km")
  notes           String?
  costTetri       Int?         @map("cost_tetri")
  purchaseId      String?      @map("purchase_id") @db.Uuid
  odooFleetId     Int?         @unique @map("odoo_fleet_id")
  odooLotId       Int?         @unique @map("odoo_lot_id")
  archived        Boolean      @default(false)
  /// The company's own number, shown EV-007; given by the database in arrival order (migration 0043).
  fleetNo         Int?         @unique @default(dbgenerated("nextval('vehicles_fleet_no_seq'::regclass)")) @map("fleet_no")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @map("updated_at")

  serviceJobs   ServiceJob[]
  donatedParts  ServicePart[]    @relation("service_part_donor")
  trackers      VehicleTracker[]
  sales         Sale[]
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id])
  model         VehicleModel   @relation(fields: [modelId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  currentRental Rental?        @relation("vehicle_current_rental", fields: [currentRentalId], references: [id])
  rentals       Rental[]       @relation("rental_vehicle")
  events        VehicleEvent[]
  /// The acts written about this moped, in whichever rental (migration 0063).
  acts          Act[]

  @@map("vehicles")
}

model Customer {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  nameKa        String?      @map("name_ka")
  nameLat       String?      @map("name_lat")
  personalId    String?      @unique @map("personal_id")
  phone         String?
  email         String?
  kind          CustomerKind @default(person)
  /// What this record is: a client, a supplier, an employee or something else (B3-06).
  recordKind    String       @default("client") @map("record_kind")
  /// A duplicate merged into another record keeps the way home (wave 5 §3.9).
  mergedIntoId  String?      @map("merged_into") @db.Uuid
  /// Where they came from: myauto, friends, social, site, other (wave 4 §3.5).
  source        String?
  tags          String[]     @default([])
  address       String?
  notes         String?
  /// A supplier's card in fields (migration 0031, Mika 28.09.2026); a client leaves them empty.
  country       String?
  contactPerson String?      @map("contact_person")
  channel       String?
  goods         String?
  bank          String?
  /// The front office's deal: a link or an id, one way only (B10-03).
  kommoRef      String?      @map("kommo_ref")
  odooPartnerId Int?         @unique @map("odoo_partner_id")
  archived      Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")

  rentals     Rental[]
  documents   StoredFile[]
  payments    Payment[]
  serviceJobs ServiceJob[]
  sales       Sale[]
  supplied    Purchase[]
  mergedInto  Customer?    @relation("customer_merge", fields: [mergedIntoId], references: [id])
  kommoLeads  KommoLead[]
  mergedFrom  Customer[]   @relation("customer_merge")

  @@map("customers")
}

model Rental {
  id                    String       @id @default(uuid()) @db.Uuid
  number                String       @unique @default(dbgenerated("('R-' || lpad(nextval('rental_number_seq')::text, 5, '0'))"))
  customerId            String       @map("customer_id") @db.Uuid
  vehicleId             String?      @map("vehicle_id") @db.Uuid
  vinUnconfirmed        Boolean      @default(false) @map("vin_unconfirmed")
  vinNote               String?      @map("vin_note")
  weeklyRateTetri       Int          @map("weekly_rate_tetri")
  depositTetri          Int          @default(18000) @map("deposit_tetri")
  pickedUpOn            DateTime?    @map("picked_up_on") @db.Date
  expectedReturnOn      DateTime?    @map("expected_return_on") @db.Date
  returnedOn            DateTime?    @map("returned_on") @db.Date
  status                RentalStatus @default(booked)
  paidThrough           DateTime?    @map("paid_through") @db.Date
  /// The weekday a week's rent is due on, ISO 1 = Monday … 7 = Sunday; null =
  /// the pickup's weekday (ADR-0022). The weeks still run from the pickup.
  payWeekday            Int?         @map("pay_weekday") @db.SmallInt
  /// The days all its weeks were made longer by an owner (ADR-0041, migration 0064):
  /// the weeks now run from the pickup plus this. Derived — only recomputeRental writes it.
  weekShiftDays         Int          @default(0) @map("week_shift_days")
  buyoutTargetTetri     Int?         @map("buyout_target_tetri")
  buyoutPerPaymentTetri Int?         @map("buyout_per_payment_tetri")
  nightParkingAddress   String?      @map("night_parking_address")
  batteries             Int?
  chargers              Int?
  notes                 String?
  kommoRef              String?      @map("kommo_ref")
  odooOrderId           Int?         @unique @map("odoo_order_id")
  odooName              String?      @map("odoo_name")
  transferredAt         DateTime?    @map("transferred_at")
  transferredById       String?      @map("transferred_by") @db.Uuid
  /// The contract was signed in Signify (or on paper), as a person marked it
  /// here; null — not marked (migration 0062, ADR-0039). Never inferred.
  contractSignedElsewhereAt   DateTime? @map("contract_signed_elsewhere_at")
  contractSignedElsewhereById String?   @map("contract_signed_elsewhere_by") @db.Uuid
  contractSignedElsewhereNote String?   @map("contract_signed_elsewhere_note")
  debtOverrideReason    String?      @map("debt_override_reason")
  createdById           String?      @map("created_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @default(now()) @map("updated_at")

  customer  Customer       @relation(fields: [customerId], references: [id])
  vehicle   Vehicle?       @relation("rental_vehicle", fields: [vehicleId], references: [id])
  driveFolders DriveFolder[]
  createdBy User?          @relation("rental_created_by", fields: [createdById], references: [id])
  contractSignedElsewhereBy User? @relation("rental_contract_signed_elsewhere_by", fields: [contractSignedElsewhereById], references: [id])
  periods   RentalPeriod[]
  deposit   Deposit?
  acts      Act[]
  events    VehicleEvent[]
  documents   StoredFile[]
  payments    Payment[]
  serviceJobs ServiceJob[]
  currentOf   Vehicle[]      @relation("vehicle_current_rental")
  charges     RentalCharge[]
  batteryMoves BatteryMove[]
  withholdings DepositWithholding[]

  @@map("rentals")
}

model RentalPeriod {
  id          String          @id @default(uuid()) @db.Uuid
  rentalId    String          @map("rental_id") @db.Uuid
  seq         Int
  startsOn    DateTime        @map("starts_on") @db.Date
  endsOn      DateTime        @map("ends_on") @db.Date
  amountTetri Int             @map("amount_tetri")
  paidBeforeTransfer Boolean @default(false) @map("paid_before_transfer")
  /// The bank's payment a week carried over as paid turned out to be (migration 0042, ADR-0023).
  carriedPaymentId String?   @map("carried_payment_id") @db.Uuid
  paidTetri   Int             @default(0) @map("paid_tetri")
  /// Taken off the week by an owner, with a reason; amountTetri is the price after it (migration 0040).
  discountTetri  Int       @default(0) @map("discount_tetri")
  discountReason String?   @map("discount_reason")
  discountedById String?   @map("discounted_by") @db.Uuid
  discountedAt   DateTime? @map("discounted_at")
  /// Days an owner made the week longer, and what they cost, with a reason (ADR-0041,
  /// migration 0064): endsOn = startsOn + 6 + extraDays; amountTetri includes extraTetri.
  extraDays      Int       @default(0) @map("extra_days") @db.SmallInt
  extraTetri     Int       @default(0) @map("extra_tetri")
  shiftReason    String?   @map("shift_reason")
  shiftedById    String?   @map("shifted_by") @db.Uuid
  shiftedAt      DateTime? @map("shifted_at")
  payStatus   PeriodPayStatus @default(unpaid) @map("pay_status")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @map("updated_at")

  rental      Rental              @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([rentalId, seq])
  @@map("rental_periods")
}

model Deposit {
  id             String        @id @default(uuid()) @db.Uuid
  rentalId       String        @unique @map("rental_id") @db.Uuid
  amountTetri    Int           @map("amount_tetri")
  status         DepositStatus @default(held)
  returnedTetri  Int           @default(0) @map("returned_tetri")
  withheldTetri  Int           @default(0) @map("withheld_tetri")
  withheldReason String?       @map("withheld_reason")
  withheldGrounds String[]     @default([]) @map("withheld_grounds")
  paidTetri       Int          @default(0) @map("paid_tetri")
  paidOutBeforeTetri Int       @default(0) @map("paid_out_before_tetri")
  receivedBeforeTransferTetri Int @default(0) @map("received_before_transfer_tetri")
  returnedTo     String?       @map("returned_to")
  returnedOn     DateTime?     @map("returned_on") @db.Date
  decidedById    String?       @map("decided_by") @db.Uuid
  confirmedById  String?       @map("confirmed_by") @db.Uuid
  notes          String?
  /// Closed by the transfer, not by a payout: see `DepositMigrationDecision`.
  migrationDecision DepositMigrationDecision? @map("migration_decision")
  migrationReason   String?                   @map("migration_reason")
  migrationDecidedAt DateTime?                @map("migration_decided_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @map("updated_at")

  rental      Rental              @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  decidedBy   User?               @relation("deposit_decided_by", fields: [decidedById], references: [id])
  confirmedBy User?               @relation("deposit_confirmed_by", fields: [confirmedById], references: [id])
  allocations PaymentAllocation[]
  payouts     Payment[]           @relation("deposit_payouts")
  withholdings DepositWithholding[]

  @@map("deposits")
}

model Act {
  id           String   @id @default(uuid()) @db.Uuid
  rentalId     String   @map("rental_id") @db.Uuid
  kind         ActKind
  occurredOn   DateTime @map("occurred_on") @db.Date
  odometerKm   Int?     @map("odometer_km")
  condition    String?
  items        Json?
  odometerReason String? @map("odometer_reason")
  locationId   String?  @map("location_id") @db.Uuid
  settlement   Json?
  signatureUrl String?  @map("signature_url")
  pdfUrl       String?  @map("pdf_url")
  /// The moped the act is about (migration 0063): a swap gives a rental more than one.
  vehicleId    String?  @map("vehicle_id") @db.Uuid
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  rental    Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdBy User?        @relation(fields: [createdById], references: [id])
  photos    StoredFile[]
  batteryMoves BatteryMove[]

  @@map("acts")
}

/// Bytes in the database (see migration 0002). `bytes` is never selected by
/// a list query — only by the one route that streams a file.
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  kind         FileKind
  actId        String?  @map("act_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  rentalId     String?  @map("rental_id") @db.Uuid
  saleId       String?  @map("sale_id") @db.Uuid
  serviceJobId String?  @map("service_job_id") @db.Uuid
  label        String   @default("")
  /// What a repair photo shows: before, after, odometer, receipt (0056).
  tag          String?
  docKind      String?  @map("doc_kind")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  bytes        Bytes
  uploadedById String?  @map("uploaded_by") @db.Uuid
  archived     Boolean  @default(false)
  signedAt     DateTime? @map("signed_at")
  signedBy     String?  @map("signed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  act        Act?      @relation(fields: [actId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rental     Rental?     @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceJob ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id])
  receiptOf  ServicePart[] @relation("service_part_receipt")

  @@map("files")
}

model VehicleEvent {
  id         String           @id @default(uuid()) @db.Uuid
  vehicleId  String           @map("vehicle_id") @db.Uuid
  kind       VehicleEventKind
  occurredOn DateTime         @map("occurred_on") @db.Date
  fromState  VehicleState?    @map("from_state")
  toState    VehicleState     @map("to_state")
  fromPool   VehiclePool?     @map("from_pool")
  toPool     VehiclePool?     @map("to_pool")
  rentalId   String?          @map("rental_id") @db.Uuid
  reason     String?
  actorId    String?          @map("actor_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rental  Rental? @relation(fields: [rentalId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@map("vehicle_events")
}

/// Money in (spec §4). gross is what the customer paid, fee is what the
/// acquirer kept, net is what the bank credited. Debts close by gross.
model Payment {
  id            String           @id @default(uuid()) @db.Uuid
  occurredOn    DateTime         @map("occurred_on") @db.Date
  direction     PaymentDirection @default(in)
  channel       PaymentChannel
  grossTetri    Int              @map("gross_tetri")
  feeTetri      Int              @default(0) @map("fee_tetri")
  netTetri      Int              @map("net_tetri")
  customerId    String?          @map("customer_id") @db.Uuid
  rentalId      String?          @map("rental_id") @db.Uuid
  saleId        String?          @map("sale_id") @db.Uuid
  purchaseId    String?          @map("purchase_id") @db.Uuid
  bankText      String?          @map("bank_text")
  source        PaymentSource    @default(manual)
  note          String?
  createdById   String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  voidedAt      DateTime?        @map("voided_at")
  voidReason    String?          @map("void_reason")
  voidedById    String?          @map("voided_by") @db.Uuid
  odooPaymentId Int?             @unique @map("odoo_payment_id")
  statementLineId String?        @map("statement_line_id") @db.Uuid
  /// Which part of a split bank line this payment is; a line paid whole is part 1 (migration 0039).
  statementPart   Int            @default(1) @map("statement_part") @db.SmallInt
  kind            PaymentKind
  serviceJobId    String?        @map("service_job_id") @db.Uuid
  depositId       String?        @map("deposit_id") @db.Uuid
  paidTo          String?        @map("paid_to")
  paidToReason    String?        @map("paid_to_reason")
  backdateReason  String?        @map("backdate_reason")
  foreignMinor    BigInt?        @map("foreign_minor")
  foreignCurrency String?        @map("foreign_currency")
  voidKind        String?        @map("void_kind")

  statementLine StatementLine?    @relation("payment_of_line", fields: [statementLineId], references: [id], onDelete: SetNull)
  customer    Customer?           @relation(fields: [customerId], references: [id])
  rental      Rental?             @relation(fields: [rentalId], references: [id])
  sale        Sale?               @relation(fields: [saleId], references: [id])
  purchase    Purchase?           @relation(fields: [purchaseId], references: [id])
  serviceJob  ServiceJob?         @relation(fields: [serviceJobId], references: [id])
  deposit     Deposit?            @relation("deposit_payouts", fields: [depositId], references: [id])
  createdBy   User?               @relation("payment_created_by", fields: [createdById], references: [id])
  voidedBy    User?               @relation("payment_voided_by", fields: [voidedById], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

/// What a payment closed: a weekly period, or the deposit.
model PaymentAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  paymentId   String           @map("payment_id") @db.Uuid
  target      AllocationTarget
  periodId      String?        @map("period_id") @db.Uuid
  depositId     String?        @map("deposit_id") @db.Uuid
  instalmentId  String?        @map("instalment_id") @db.Uuid
  chargeId      String?        @map("charge_id") @db.Uuid
  amountTetri Int              @map("amount_tetri")
  createdAt   DateTime         @default(now()) @map("created_at")

  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  period     RentalPeriod?   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  deposit    Deposit?        @relation(fields: [depositId], references: [id], onDelete: Cascade)
  instalment SaleInstalment? @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  charge     RentalCharge?   @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@map("payment_allocations")
}

/// A file the bank gave us, kept so a line can be traced back to it.
model Statement {
  id          String    @id @default(uuid()) @db.Uuid
  bank        BankName
  fileName    String    @map("file_name")
  fileSha256  String    @map("file_sha256")
  account     String?
  periodFrom  DateTime? @map("period_from") @db.Date
  periodTo    DateTime? @map("period_to") @db.Date
  lineCount   Int       @default(0) @map("line_count")
  newLines    Int       @default(0) @map("new_lines")
  matched     Int       @default(0)
  uploadedById String?  @map("uploaded_by") @db.Uuid
  /// 'file' for an upload; 'api' for a day a bank was asked about by its API, one per bank, account and day (migrations 0041, 0045).
  source      String    @default("file")
  createdAt   DateTime  @default(now()) @map("created_at")

  uploadedBy User?           @relation(fields: [uploadedById], references: [id])
  lines      StatementLine[]

  @@map("statements")
}

/// One row of a statement, as it arrived. `naturalKey` is what makes a
/// second upload of the same file a no-op.
model StatementLine {
  id          String              @id @default(uuid()) @db.Uuid
  statementId String              @map("statement_id") @db.Uuid
  bank        BankName
  naturalKey  String              @map("natural_key")
  /// The bank's document number: how one operation is known in a file and in the API alike (migration 0041).
  docNo       String?             @map("doc_no")
  occurredOn  DateTime            @map("occurred_on") @db.Date
  direction   PaymentDirection
  amountTetri Int                 @map("amount_tetri")
  grossTetri  Int?                @map("gross_tetri")
  feeTetri    Int?                @map("fee_tetri")
  payer       String?
  purpose     String?
  raw         String
  status      StatementLineStatus @default(unmatched)
  matchedRule String?             @map("matched_rule")
  resolution  String?
  resolutionReason String?        @map("resolution_reason")
  resolvedById String?            @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?           @map("resolved_at")
  paymentId   String?             @map("payment_id") @db.Uuid
  /// Money going out as an expense: what it was for, and the remembered payee that sorted it (migration 0046).
  expenseCategoryId String?       @map("expense_category_id") @db.Uuid
  expenseRuleId     String?       @map("expense_rule_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  payments  Payment[] @relation("payment_of_line")
  bankDeposit BankCashDeposit?
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  expenseRule     ExpenseRule?     @relation(fields: [expenseRuleId], references: [id])
  expenseParts    StatementLineExpensePart[]

  @@unique([bank, naturalKey])
  @@map("statement_lines")
}

/// One outgoing line split into several expenses, each with its category (migration 0050, ADR-0030).
model StatementLineExpensePart {
  id          String @id @default(uuid()) @db.Uuid
  lineId      String @map("line_id") @db.Uuid
  seq         Int    @db.SmallInt
  amountTetri Int    @map("amount_tetri")
  categoryId  String @map("category_id") @db.Uuid

  line     StatementLine   @relation(fields: [lineId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([lineId, seq])
  @@map("statement_line_expense_parts")
}

/// What money going out was for (migration 0046): twelve to begin with, an owner keeps the list.
model ExpenseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  nameRu      String   @map("name_ru")
  nameKa      String?  @map("name_ka")
  nameEn      String?  @map("name_en")
  sortOrder   Int      @default(0) @map("sort_order")
  archived    Boolean  @default(false)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lines StatementLine[]
  rules ExpenseRule[]
  parts StatementLineExpensePart[]

  @@map("expense_categories")
}

/// "Remember this payee": its next line is sorted into the category by itself (migration 0046).
model ExpenseRule {
  id           String    @id @default(uuid()) @db.Uuid
  payeeKey     String    @map("payee_key")
  categoryId   String    @map("category_id") @db.Uuid
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by") @db.Uuid

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  lines    StatementLine[]

  @@map("expense_rules")
}

/// A repair (SRV-01). Opened on a VIN; charged to the company or to the
/// renter, and a renter can be charged by keeping part of the deposit.
model ServiceJob {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique @default(dbgenerated("('SV-' || lpad(nextval('service_number_seq')::text, 5, '0'))"))
  vehicleId     String        @map("vehicle_id") @db.Uuid
  rentalId      String?       @map("rental_id") @db.Uuid
  customerId    String?       @map("customer_id") @db.Uuid
  reason        String
  openedOn      DateTime      @map("opened_on") @db.Date
  closedOn      DateTime?     @map("closed_on") @db.Date
  status        ServiceStatus @default(open)
  payer         ServicePayer  @default(company)
  labourTetri   Int           @default(0) @map("labour_tetri")
  /// Work as it was entered: minutes at a rate (`service.md`, 50 ₾/hour).
  labourMinutes Int           @default(0) @map("labour_minutes")
  labourRateTetri Int         @default(5000) @map("labour_rate_tetri")
  workshopId    String?       @map("workshop_id") @db.Uuid
  closedLocationId String?    @map("closed_location_id") @db.Uuid
  odometerKm    Int?          @map("odometer_km")
  /// What the customer owes for this repair after the deposit was drawn on (Q26).
  chargedTetri  Int           @default(0) @map("charged_tetri")
  notes         String?
  movedVehicle  Boolean       @default(false) @map("moved_vehicle")
  withheldTetri Int           @default(0) @map("withheld_tetri")
  odooRepairId  Int?          @unique @map("odoo_repair_id")
  /// Who carries the repair: a mechanic's "own repairs" are these (0056).
  mechanicId    String?       @map("mechanic_id") @db.Uuid
  reasonKind    ServiceReason? @map("reason_kind")
  /// The odometer when the repair was opened; `odometerKm` is the reading at closing.
  openedOdometerKm Int?       @map("opened_odometer_km")
  /// Why the odometer reads less than the moped's last reading.
  odometerReason String?      @map("odometer_reason")
  /// The minute the repair was opened; empty on repairs from before 0056.
  openedAt      DateTime?     @default(now()) @map("opened_at")
  /// The first approval — the one that let the work start (0057).
  approvedById  String?       @map("approved_by") @db.Uuid
  approvedAt    DateTime?     @map("approved_at")
  /// A refused repair is `cancelled` with who refused it, when and why (0057).
  rejectedById  String?       @map("rejected_by") @db.Uuid
  rejectedAt    DateTime?     @map("rejected_at")
  rejectReason  String?       @map("reject_reason")
  /// The minute it closed; repairs before 0057 have only the day.
  closedAt      DateTime?     @map("closed_at")
  /// Why the reading at closing is below the opening's or the moped's last (0060, ADR-0038 §4).
  closedOdometerReason String? @map("closed_odometer_reason")
  /// The payout that paid its mechanic for it — only his, only once it is closed; empty — not paid (0059, ADR-0037).
  paidInPayoutId String?      @map("paid_in_payout_id") @db.Uuid
  createdById   String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @map("updated_at")

  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  rental    Rental?       @relation(fields: [rentalId], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id])
  createdBy User?         @relation("service_job_created_by", fields: [createdById], references: [id])
  mechanic  User?         @relation("service_job_mechanic", fields: [mechanicId], references: [id])
  approvedBy User?        @relation("service_job_approved_by", fields: [approvedById], references: [id])
  rejectedBy User?        @relation("service_job_rejected_by", fields: [rejectedById], references: [id])
  works     ServiceWork[]
  workshop  Workshop?     @relation(fields: [workshopId], references: [id])
  closedLocation Location? @relation(fields: [closedLocationId], references: [id])
  parts     ServicePart[]
  photos    StoredFile[]
  payments  Payment[]
  withholdings DepositWithholding[]
  batteryMoves BatteryMove[]
  trackersFitted  VehicleTracker[] @relation("vehicle_tracker_job")
  trackersRemoved VehicleTracker[] @relation("vehicle_tracker_removed_job")
  paidInPayout MechanicPayout? @relation("service_job_paid_in_payout", fields: [paidInPayoutId, mechanicId], references: [id, mechanicId])

  @@map("service_jobs")
}

model ServicePart {
  id             String   @id @default(uuid()) @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  name           String
  qty            Int      @default(1)
  unitPriceTetri Int      @map("unit_price_tetri")
  /// What it cost the shelf, beside what it went on the line at (B8-04).
  unitCostTetri  Int?     @map("unit_cost_tetri")
  partId         String?  @map("part_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  /// Off the shelf, bought, taken off onto the shelf, or from a donor (0058).
  kind           ServicePartKind @default(stock)
  donorVehicleId String?  @map("donor_vehicle_id") @db.Uuid
  /// Bought: what the mechanic paid for the whole line, by the receipt.
  paidTetri      Int?     @map("paid_tetri")
  receiptPhotoId String?  @map("receipt_photo_id") @db.Uuid
  reimburseToId  String?  @map("reimburse_to") @db.Uuid
  createdById    String?  @map("created_by") @db.Uuid
  /// Bought only: neither set — the line waits for approval (0058, as works in 0057).
  approvedById   String?  @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  rejectedById   String?  @map("rejected_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at")
  rejectReason   String?  @map("reject_reason")
  /// Bought: the payout that paid the receipt back to `reimburseTo` — his payout only (0059, ADR-0037).
  paidInPayoutId String?  @map("paid_in_payout_id") @db.Uuid

  job          ServiceJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part         Part?       @relation(fields: [partId], references: [id])
  moves        StockMove[]
  donor        Vehicle?    @relation("service_part_donor", fields: [donorVehicleId], references: [id])
  receiptPhoto StoredFile? @relation("service_part_receipt", fields: [receiptPhotoId], references: [id])
  reimburseTo  User?       @relation("service_part_reimburse_to", fields: [reimburseToId], references: [id])
  createdBy    User?       @relation("service_part_created_by", fields: [createdById], references: [id])
  approvedBy   User?       @relation("service_part_approved_by", fields: [approvedById], references: [id])
  rejectedBy   User?       @relation("service_part_rejected_by", fields: [rejectedById], references: [id])
  trackers     VehicleTracker[]
  paidInPayout MechanicPayout? @relation("service_part_paid_in_payout", fields: [paidInPayoutId, reimburseToId], references: [id, mechanicId])

  @@map("service_parts")
}

/// The owner's mark that a mechanic was paid for closed repairs and receipts (0059, ADR-0037):
/// not a payment and not an expense. What it paid is the sum of the two figures, never a stored total.
model MechanicPayout {
  id             String    @id @default(uuid()) @db.Uuid
  mechanicId     String    @map("mechanic_id") @db.Uuid
  /// The Tbilisi day it was marked.
  paidOn         DateTime  @map("paid_on") @db.Date
  /// The approved work of its repairs, each repair rounded once (ADR-0037 §8).
  labourTetri    Int       @map("labour_tetri")
  /// The receipts it paid back, to the tetri.
  reimburseTetri Int       @map("reimburse_tetri")
  markedById     String    @map("marked_by") @db.Uuid
  markedAt       DateTime  @default(now()) @map("marked_at")
  /// A payout marked by mistake is voided with a reason; its repairs are payable again (ADR-0037 §5).
  voidedAt       DateTime? @map("voided_at")
  voidedById     String?   @map("voided_by") @db.Uuid
  voidReason     String?   @map("void_reason")

  mechanic User          @relation("mechanic_payout_mechanic", fields: [mechanicId], references: [id])
  markedBy User          @relation("mechanic_payout_marked_by", fields: [markedById], references: [id])
  voidedBy User?         @relation("mechanic_payout_voided_by", fields: [voidedById], references: [id])
  jobs     ServiceJob[]  @relation("service_job_paid_in_payout")
  parts    ServicePart[] @relation("service_part_paid_in_payout")

  @@unique([id, mechanicId])
  @@map("mechanic_payouts")
}

/// A category of the book of works: BR — brakes. Its name is translated once (0056).
model WorkCategory {
  code      String   @id
  nameKa    String?  @map("name_ka")
  nameRu    String?  @map("name_ru")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  works WorkType[]

  @@map("work_categories")
}

/// A work in the book: a permanent code and a norm in seconds (0056).
model WorkType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  category    String
  nameKa      String?  @map("name_ka")
  nameRu      String?  @map("name_ru")
  nameEn      String?  @map("name_en")
  normSec     Int      @map("norm_sec")
  active      Boolean  @default(true)
  notes       String?
  /// 'bot-2026-10-11' for the bot's CATALOG_SEED; empty for a work added on the screen.
  source      String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  categoryRow WorkCategory  @relation(fields: [category], references: [code])
  createdBy   User?         @relation(fields: [createdById], references: [id])
  lines       ServiceWork[]

  @@map("work_types")
}

/// A line of work on a repair: the norm and the rate are copies, made when it was written (0056).
model ServiceWork {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  workTypeId  String?  @map("work_type_id") @db.Uuid
  freeText    String?  @map("free_text")
  qty         Int      @default(1)
  /// Empty — a work not in the book, with no norm yet.
  normSec     Int?     @map("norm_sec")
  rateTetri   Int      @map("rate_tetri")
  mechanicId  String?  @map("mechanic_id") @db.Uuid
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  /// Neither set — the line waits for approval with its repair (0057).
  approvedById String?  @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  rejectedById String?  @map("rejected_by") @db.Uuid
  rejectedAt   DateTime? @map("rejected_at")
  rejectReason String?  @map("reject_reason")

  job       ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workType  WorkType?  @relation(fields: [workTypeId], references: [id])
  mechanic  User?      @relation("service_work_mechanic", fields: [mechanicId], references: [id])
  createdBy User?      @relation("service_work_created_by", fields: [createdById], references: [id])
  approvedBy User?     @relation("service_work_approved_by", fields: [approvedById], references: [id])
  rejectedBy User?     @relation("service_work_rejected_by", fields: [rejectedById], references: [id])

  @@map("service_works")
}

/// One VIN leaving the fleet for one customer (SAL-01). Ending it the other
/// way round — the company buying it back — is the same row, so the VIN's
/// history holds both events (SAL-03).
model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  number        String     @unique @default(dbgenerated("('SL-' || lpad(nextval('sale_number_seq')::text, 5, '0'))"))
  customerId    String     @map("customer_id") @db.Uuid
  vehicleId     String?    @map("vehicle_id") @db.Uuid
  vinNote       String?    @map("vin_note")
  soldOn        DateTime   @map("sold_on") @db.Date
  priceTetri    Int        @map("price_tetri")
  extras        String?
  warrantyUntil DateTime?  @map("warranty_until") @db.Date
  status        SaleStatus @default(active)
  boughtBackOn  DateTime?  @map("bought_back_on") @db.Date
  /// Carried over from the paper contract: what had been paid by the day of the move (B3-03).
  paidBeforeTetri Int      @default(0) @map("paid_before_tetri")
  transferred   Boolean    @default(false)
  notes         String?
  kommoRef      String?    @map("kommo_ref")
  odooOrderId   Int?       @unique @map("odoo_order_id")
  createdById   String?    @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @map("updated_at")

  customer    Customer         @relation(fields: [customerId], references: [id])
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id])
  createdBy   User?            @relation(fields: [createdById], references: [id])
  instalments SaleInstalment[]
  payments    Payment[]
  documents   StoredFile[]

  @@map("sales")
}

/// A line of the schedule (SAL-02). A sale paid in one go has exactly one.
model SaleInstalment {
  id          String          @id @default(uuid()) @db.Uuid
  saleId      String          @map("sale_id") @db.Uuid
  seq         Int
  dueOn       DateTime        @map("due_on") @db.Date
  amountTetri Int             @map("amount_tetri")
  paidTetri   Int             @default(0) @map("paid_tetri")
  payStatus   PeriodPayStatus @default(unpaid) @map("pay_status")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @map("updated_at")

  sale        Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([saleId, seq])
  @@map("sale_instalments")
}

/// An invoice from a factory or a marketplace (PUR-01). Lines are in the
/// seller's currency; what a unit cost is derived from the payments.
model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique @default(dbgenerated("('PO-' || lpad(nextval('purchase_number_seq')::text, 5, '0'))"))
  supplierId   String         @map("supplier_id") @db.Uuid
  invoiceNo    String?        @map("invoice_no")
  invoiceDate  DateTime?      @map("invoice_date") @db.Date
  currency     String         @default("CNY")
  orderedOn    DateTime       @map("ordered_on") @db.Date
  receivedOn   DateTime?      @map("received_on") @db.Date
  status       PurchaseStatus @default(ordered)
  extrasTetri  Int            @default(0) @map("extras_tetri")
  extrasNote   String?        @map("extras_note")
  /// Paid before this system existed: GEL that left, what it bought, and when (B3-04).
  paidBeforeTetri Int         @default(0) @map("paid_before_tetri")
  paidBeforeMinor BigInt      @default(0) @map("paid_before_minor")
  paidBeforeOn DateTime?      @map("paid_before_on") @db.Date
  /// When the shipment's costs were last worked out from its payments (§7).
  costedAt     DateTime?      @map("costed_at")
  notes        String?
  odooOrderId  Int?           @unique @map("odoo_order_id")
  createdById  String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")

  supplier  Customer       @relation(fields: [supplierId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  lines     PurchaseLine[]
  payments  Payment[]
  vehicles  Vehicle[]

  @@map("purchases")
}

model PurchaseLine {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseId     String   @map("purchase_id") @db.Uuid
  modelId        String?  @map("model_id") @db.Uuid
  partName       String?  @map("part_name")
  qty            Int
  unitPriceMinor Int      @map("unit_price_minor")
  partId         String?  @map("part_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  model    VehicleModel? @relation(fields: [modelId], references: [id])
  part     Part?         @relation(fields: [partId], references: [id])
  moves    StockMove[]

  @@map("purchase_lines")
}

/// A part the company keeps on the shelf. How many are there is never
/// stored — it is the sum of `StockMove`.
/// Who does the repairs (`service.md`, wave 5 §3.7). The owner keeps the list;
/// a repair points at one instead of spelling its name again.
model Workshop {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  note        String?
  sortOrder   Int      @default(0) @map("sort_order")
  archived    Boolean  @default(false)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  createdBy User?        @relation(fields: [createdById], references: [id])
  jobs      ServiceJob[]

  @@map("workshops")
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  sku            String?  @unique
  name           String
  nameKa         String?  @map("name_ka")
  unit           String   @default("pcs")
  minQty         Int      @default(0) @map("min_qty")
  salePriceTetri Int?     @map("sale_price_tetri")
  notes          String?
  archived       Boolean  @default(false)
  /// A GPS tracker: fitting one asks for its IMEI and SIM (0058).
  isTracker      Boolean  @default(false) @map("is_tracker")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  createdBy     User?          @relation(fields: [createdById], references: [id])
  moves         StockMove[]
  purchaseLines PurchaseLine[]
  serviceParts  ServicePart[]
  trackers      VehicleTracker[]

  @@map("parts")
}

/// One movement on or off the shelf, signed. Nothing else changes a count.
model StockMove {
  id             String        @id @default(uuid()) @db.Uuid
  partId         String        @map("part_id") @db.Uuid
  kind           StockMoveKind
  qty            Int
  unitCostTetri  Int?          @map("unit_cost_tetri")
  occurredOn     DateTime      @map("occurred_on") @db.Date
  purchaseLineId String?       @map("purchase_line_id") @db.Uuid
  servicePartId  String?       @map("service_part_id") @db.Uuid
  reason         String?
  createdById    String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  part         Part          @relation(fields: [partId], references: [id])
  purchaseLine PurchaseLine? @relation(fields: [purchaseLineId], references: [id])
  servicePart  ServicePart?  @relation(fields: [servicePartId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@map("stock_moves")
}

enum StockMoveKind {
  receipt
  issue
  adjust
  /// Parts of a cancelled repair going back on the shelf (wave 5 §3.7).
  return

  @@map("stock_move_kind")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

/// A manager hands the cash they took to an owner (money.md, В3).
model CashHandover {
  id           String         @id @default(uuid()) @db.Uuid
  fromUserId   String         @map("from_user") @db.Uuid
  amountTetri  Int            @map("amount_tetri")
  handedAt     DateTime       @default(now()) @map("handed_at")
  status       HandoverStatus @default(pending)
  countedTetri Int?           @map("counted_tetri")
  reason       String?
  decidedById  String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at")

  fromUser  User  @relation("handover_from", fields: [fromUserId], references: [id])
  decidedBy User? @relation("handover_decided_by", fields: [decidedById], references: [id])

  @@map("cash_handovers")
}

/// Cash an owner took to the bank: out of the till, found by the statement's cash-deposit line.
model BankCashDeposit {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  amountTetri     Int       @map("amount_tetri")
  bank            BankName
  occurredOn      DateTime  @map("occurred_on") @db.Date
  statementLineId String?   @unique @map("statement_line_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  voidedAt        DateTime? @map("voided_at")
  voidReason      String?   @map("void_reason")

  user          User           @relation(fields: [userId], references: [id])
  statementLine StatementLine? @relation(fields: [statementLineId], references: [id], onDelete: SetNull)

  @@map("bank_cash_deposits")
}

/// One row: what a hand-over proposes when nobody says otherwise (wave 6 §3.5).
model RentalSettings {
  id           Boolean  @id @default(true)
  depositTetri Int      @default(18000) @map("deposit_tetri")
  /// The telephone on the moped sticker for a customer with a breakdown; none — the line is left out.
  stickerPhone String?  @map("sticker_phone")
  updatedById  String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("rental_settings")
}

/// The repair settings an owner sets (0060, ADR-0038 §3): the company rate for an hour of norm and the planned maintenance.
model ServiceSettings {
  id                    Boolean  @id @default(true)
  /// What a mechanic without a rate of his own is paid for an hour of norm.
  defaultRateTetri      Int      @default(5000) @map("default_rate_tetri")
  maintenanceIntervalKm Int      @default(5000) @map("maintenance_interval_km")
  /// «Пора на ТО» when fewer kilometres than this are left.
  maintenanceWarnKm     Int      @default(300) @map("maintenance_warn_km")
  updatedById           String?  @map("updated_by") @db.Uuid
  updatedAt             DateTime @default(now()) @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("service_settings")
}

/// The weekly rates offered as buttons beside the model's own (R5).
model QuickRate {
  id          String   @id @default(uuid()) @db.Uuid
  rateTetri   Int      @map("rate_tetri")
  sortOrder   Int      @default(0) @map("sort_order")
  archived    Boolean  @default(false)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("quick_rates")
}

/// One row: from when the till counts.
model MoneySettings {
  id        Boolean  @id @default(true)
  tillSince DateTime @default(now()) @map("till_since")

  @@map("money_settings")
}

/// What a return charges beyond the weeks: a key, days of delay, what an owner kept (wave 3).
model RentalCharge {
  id          String    @id @default(uuid()) @db.Uuid
  rentalId    String    @map("rental_id") @db.Uuid
  kind        String
  amountTetri Int       @map("amount_tetri")
  note        String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  voidedAt    DateTime? @map("voided_at")

  rental      Rental              @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@map("rental_charges")
}

/// What was kept from a deposit, one row per decision: a repair's and a return's side by side (B5-04).
model DepositWithholding {
  id           String    @id @default(uuid()) @db.Uuid
  depositId    String    @map("deposit_id") @db.Uuid
  source       String
  rentalId     String?   @map("rental_id") @db.Uuid
  serviceJobId String?   @map("service_job_id") @db.Uuid
  amountTetri  Int       @map("amount_tetri")
  grounds      String[]  @default([])
  reason       String
  paymentId    String?   @map("payment_id") @db.Uuid
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  voidedAt     DateTime? @map("voided_at")

  deposit    Deposit     @relation(fields: [depositId], references: [id], onDelete: Cascade)
  rental     Rental?     @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  serviceJob ServiceJob? @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)

  @@map("deposit_withholdings")
}

/// An owner's stocktake of the batteries (wave 4 §3.8): the truth of that day.
model BatteryInventory {
  id          String   @id @default(uuid()) @db.Uuid
  countedOn   DateTime @map("counted_on") @db.Date
  showroomQty Int      @map("showroom_qty")
  repairQty   Int      @map("repair_qty")
  couriersQty Int      @map("couriers_qty")
  totalQty    Int      @map("total_qty")
  /// What the row counts: battery or charger (migration 0044).
  item        String   @default("battery")
  reason      String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("battery_inventories")
}

/// What happened to the count since: to repair and back, lost on a return.
model BatteryMove {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  qty         Int
  /// What the row counts: battery or charger (migration 0044).
  item        String   @default("battery")
  reason      String?
  rentalId    String?  @map("rental_id") @db.Uuid
  actId       String?  @map("act_id") @db.Uuid
  /// The repair a battery or a charger went to, or came back from (0058).
  serviceJobId String? @map("service_job_id") @db.Uuid
  occurredOn  DateTime @map("occurred_on") @db.Date
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  rental     Rental?     @relation(fields: [rentalId], references: [id])
  act        Act?        @relation(fields: [actId], references: [id])
  serviceJob ServiceJob? @relation(fields: [serviceJobId], references: [id])
  createdBy  User?       @relation(fields: [createdById], references: [id])

  @@index([occurredOn, createdAt])
  @@map("battery_moves")
}

/// The GPS tracker on a moped, by IMEI and SIM, from fitting to removal (0058, ADR-0036).
model VehicleTracker {
  id            String    @id @default(uuid()) @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  partId        String?   @map("part_id") @db.Uuid
  imei          String
  simPhone      String?   @map("sim_phone")
  installedOn   DateTime  @map("installed_on") @db.Date
  removedOn     DateTime? @map("removed_on") @db.Date
  serviceJobId  String?   @map("service_job_id") @db.Uuid
  servicePartId String?   @map("service_part_id") @db.Uuid
  removedJobId  String?   @map("removed_job_id") @db.Uuid
  source        String?
  createdById   String?   @map("created_by") @db.Uuid
  removedById   String?   @map("removed_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  part        Part?        @relation(fields: [partId], references: [id])
  serviceJob  ServiceJob?  @relation("vehicle_tracker_job", fields: [serviceJobId], references: [id])
  servicePart ServicePart? @relation(fields: [servicePartId], references: [id])
  removedJob  ServiceJob?  @relation("vehicle_tracker_removed_job", fields: [removedJobId], references: [id])
  createdBy   User?        @relation("vehicle_tracker_created_by", fields: [createdById], references: [id])
  removedBy   User?        @relation("vehicle_tracker_removed_by", fields: [removedById], references: [id])

  @@map("vehicle_trackers")
}

/// A deal standing in Kommo's "rented" stage at the last poll that worked
/// (migration 0032, ADR-0012). The id is Kommo's, kept as text.
model KommoLead {
  leadId       String    @id @map("lead_id")
  name         String
  contactName  String?   @map("contact_name")
  statusId     BigInt    @map("status_id")
  /// rent — standing in the rented stage; sale — closed as won in the sales pipeline (migration 0035).
  kind         String    @default("rent")
  contactPhone String?   @map("contact_phone")
  /// When Kommo closed a won deal; a deal in the rented stage has none.
  closedAt     DateTime? @map("closed_at")
  /// The card the deal was tied to: found by its Kommo link or its phone, or made from the contact.
  customerId   String?   @map("customer_id") @db.Uuid
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  seenAt       DateTime  @default(now()) @map("seen_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("kommo_leads")
}

/// One row: when Kommo last answered and why the last asking failed.
model KommoSync {
  id             Boolean   @id @default(true)
  lastOkAt       DateTime? @map("last_ok_at")
  lastTryAt      DateTime? @map("last_try_at")
  lastFailure    String?   @map("last_failure")
  lastHttpStatus Int?      @map("last_http_status")
  leads          Int       @default(0)
  /// When this stand began taking deals in: a sale closed before it is history, not a task (migration 0035).
  intakeFrom     DateTime? @map("intake_from")

  @@map("kommo_sync")
}

/// The Bank of Georgia API (B11-03, migration 0041): when it last answered,
/// why it last failed, and which day the nightly reading has reached.
model BogSync {
  id              Boolean   @id @default(true)
  lastOkAt        DateTime? @map("last_ok_at")
  lastTryAt       DateTime? @map("last_try_at")
  lastFailure     String?   @map("last_failure")
  lastHttpStatus  Int?      @map("last_http_status")
  todayCount      Int       @default(0) @map("today_count")
  nightThrough    DateTime? @map("night_through") @db.Date
  nightAt         DateTime? @map("night_at")
  nightFailure    String?   @map("night_failure")
  nightHttpStatus Int?      @map("night_http_status")
  nightAdded      Int       @default(0) @map("night_added")

  @@map("bog_sync")
}

/// TBC read by its Business Integration Services (migration 0045, ADR-0026): one row, as bog_sync.
model TbcSync {
  id              Boolean   @id @default(true)
  lastOkAt        DateTime? @map("last_ok_at")
  lastTryAt       DateTime? @map("last_try_at")
  lastFailure     String?   @map("last_failure")
  lastHttpStatus  Int?      @map("last_http_status")
  todayCount      Int       @default(0) @map("today_count")
  nightThrough    DateTime? @map("night_through") @db.Date
  nightAt         DateTime? @map("night_at")
  nightFailure    String?   @map("night_failure")
  nightHttpStatus Int?      @map("night_http_status")
  nightMismatchOn DateTime? @map("night_mismatch_on") @db.Date
  nightAdded      Int       @default(0) @map("night_added")

  @@map("tbc_sync")
}

/// A renter's folder in the rentals folders of Drive, as last read (migration 0051, ADR-0031).
model DriveFolder {
  id        String    @id
  name      String
  section   String
  webUrl    String?   @map("web_url")
  datedOn   DateTime? @map("dated_on") @db.Date
  rentalId  String?   @map("rental_id") @db.Uuid
  matchedBy String?   @map("matched_by")
  seenAt    DateTime  @default(now()) @map("seen_at")

  rental Rental?     @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  files  DriveFile[]

  @@index([rentalId])
  @@map("drive_folders")
}

/// A document in a renter's folder; what a Signify PDF says, once read (migration 0051).
model DriveFile {
  id             String    @id
  folderId       String    @map("folder_id")
  name           String
  kind           String
  modifiedAt     DateTime  @map("modified_at")
  webUrl         String?   @map("web_url")
  readModifiedAt DateTime? @map("read_modified_at")
  datedOn        DateTime? @map("dated_on") @db.Date
  contractOn     DateTime? @map("contract_on") @db.Date
  vin            String?
  depositTetri   Int?      @map("deposit_tetri")
  withheldTetri  Int?      @map("withheld_tetri")
  paidBackTetri  Int?      @map("paid_back_tetri")
  seenAt         DateTime  @default(now()) @map("seen_at")

  folder DriveFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("drive_files")
}

/// How the last read of Drive went (migration 0051).
model DriveSync {
  id        Int       @id @default(1) @db.SmallInt
  lastTryAt DateTime? @map("last_try_at")
  lastOkAt  DateTime? @map("last_ok_at")
  failure   String?
  folders   Int       @default(0)
  files     Int       @default(0)

  @@map("drive_sync")
}


/// A notice to the workshop's Telegram group (migration 0061; ADR-0038 §6–7):
/// written with its event, sent after it, tried again by the worker. Only
/// what was asked and how it went; the text is written from `entityId` when
/// it is sent.
model Notice {
  id             String    @id @default(uuid()) @db.Uuid
  /// job_waiting, job_approved, job_rejected, job_closed, maintenance_due, stock_low.
  kind           String
  dedupeKey      String    @unique @map("dedupe_key")
  entityId       String    @map("entity_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  nextTryAt      DateTime  @default(now()) @map("next_try_at")
  attempts       Int       @default(0)
  sentAt         DateTime? @map("sent_at")
  gaveUpAt       DateTime? @map("gave_up_at")
  /// Our word for the last failure, never Telegram's answer.
  lastFailure    String?   @map("last_failure")
  lastHttpStatus Int?      @map("last_http_status")

  @@map("notices")
}
