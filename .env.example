# EV8 Ops — copy to .env and adjust. Compose reads this file.
POSTGRES_USER=ev8ops
POSTGRES_PASSWORD=ev8ops
POSTGRES_DB=ev8ops
DATABASE_URL=postgresql://ev8ops:ev8ops@localhost:5432/ev8ops
SESSION_SECRET=dev-secret-change-me
ALLOW_DEV_SECRET=true
API_PORT=8080
WEB_PORT=5173
TZ=Asia/Tbilisi
DEFAULT_LOCALE=ka
# First owner login (applies only to an empty database)
OWNER_EMAIL=mika@selfstudio.se
OWNER_NAME=Mika

# --- Integrations: leave empty until each stage; never commit real values ---
# Odoo (one-time migration source, read-only). The migration tool reads
# ~/.config/ev8/odoo.env instead; these are here only for CI-less local runs.
ODOO_URL=https://emotion-motors.odoo.com
ODOO_DB=emotion-motors
ODOO_USER=
ODOO_API_KEY=
# Bank of Georgia Business Online API (stage 2, read-only scope)
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# WhatsApp Cloud API (stage 3)
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Kommo (stage 3)
KOMMO_SUBDOMAIN=ev8mopeds
KOMMO_LONG_LIVED_TOKEN=
KOMMO_WEBHOOK_SECRET=
