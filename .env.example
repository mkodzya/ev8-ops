# EV8 Ops — copy to .env and adjust. Compose reads this file.
# Ports are offset from Self Platform's, which runs on the same Mac.
POSTGRES_USER=ev8ops
POSTGRES_PASSWORD=ev8ops
POSTGRES_DB=ev8ops
DB_PORT=5433
DATABASE_URL=postgresql://ev8ops:ev8ops@localhost:5433/ev8ops
# Laptop values. Both are refused on a stand: the API accepts them only while
# ALLOW_DEV_SECRET is true, which docker-compose.stand.yml turns off.
# A real one:  openssl rand -base64 48
SESSION_SECRET=dev-secret-change-me
# What the worker shows the API when it asks for the nightly job. That job
# opens a rental week and spends a customer's credit on it, so it is held to
# the same rule as the session secret.
WORKER_TOKEN=dev-worker-token
ALLOW_DEV_SECRET=true
API_PORT=8082
WEB_PORT=5175
TZ=Asia/Tbilisi
DEFAULT_LOCALE=ka
# Hostnames the web server answers to besides localhost, bare IPs and *.local
ALLOWED_HOSTS=
# First owner login (applies only to an empty database). A stand supplies its
# own through the server environment; nothing here is a password anybody uses
# twice.
OWNER_EMAIL=mika@selfstudio.se
OWNER_NAME=Mika
OWNER_PASSWORD=ev8-dev-password
# Worker: nightly roll of weekly rental periods (Asia/Tbilisi)
PERIODS_CRON=10 0 * * *

# --- Integrations: leave empty until each stage; never commit real values ---
# Odoo (one-time migration source, read-only). tools/migrate_stage1.py reads
# ~/.config/ev8/odoo.env instead; these are here only for CI-less local runs.
ODOO_URL=https://emotion-motors.odoo.com
ODOO_DB=emotion-motors
ODOO_USER=
ODOO_API_KEY=
# Bank of Georgia Business Online API (stage 2, read-only scope)
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# WhatsApp Cloud API (stage 3)
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Kommo (stage 3)
KOMMO_SUBDOMAIN=ev8mopeds
KOMMO_LONG_LIVED_TOKEN=
KOMMO_WEBHOOK_SECRET=
