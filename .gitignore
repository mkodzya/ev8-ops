node_modules/
dist/
# Every environment file except the examples: they hold DB passwords, session
# secrets, bank and Meta keys in plain text.
.env
.env.*
!.env.example
# The shapes are committed, the filled files never are: .env.prod.example and
# .env.test.example say which values a server needs, .env.prod and .env.test
# hold them and stay on the server.
!.env.*.example
# The server stands' own files, filled on the server and never here.
# deploy/qa.env is this Mac's QA stand and holds no secret, so it stays.
deploy/prod.env
deploy/test.env
deploy/pilot.env
*.log
apps/api/src/generated/
.pgdata/
backups/
playwright-report/
screenshots/*.png
# Real business data never enters the repository: Odoo snapshots, demo data
# built from them, bank statements, contracts. They live in ~/Desktop/EV8-ops.
data/
*.snapshot.json
demo_data.json
odoo_snapshot.json
*.xlsx
*.csv
*.pdf
# macOS Finder litter.
.DS_Store
